#!/bin/sh
# Development launcher: runs this checkout's built binary. `panelink` alone
# opens (or reattaches to) your workspace; arguments pass through unchanged.
set -eu

# Resolve symlinks (e.g. ~/.local/bin/panelink) so the checkout is found.
script_path=$0
while [ -L "$script_path" ]; do
    link_target=$(readlink "$script_path")
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path=$(dirname "$script_path")/$link_target ;;
    esac
done
project_root=$(CDPATH= cd "$(dirname "$script_path")/.." && pwd -P)
binary="$project_root/target/debug/panelink"

if [ ! -x "$binary" ]; then
    printf 'Build Panelink first: cd %s && cargo build --locked\n' "$project_root" >&2
    exit 1
fi

exec "$binary" "$@"
