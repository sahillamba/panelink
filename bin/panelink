#!/bin/sh
# Development launcher: keep normal subcommands and open the shell probe by default.
set -eu

project_root=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P)
binary="$project_root/target/debug/panelink"

if [ ! -x "$binary" ]; then
    printf 'Build Panelink first: cd %s && cargo build --locked\n' "$project_root" >&2
    exit 1
fi

if [ "$#" -gt 0 ]; then
    exec "$binary" "$@"
fi

terminfo_dir="$(mktemp -d "${TMPDIR:-/tmp}/panelink-terminfo.XXXXXX")"
trap 'rm -rf "$terminfo_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
/usr/bin/tic -x -o "$terminfo_dir" "$project_root/docs/terminfo/panelink-probe.terminfo"
# Keep the launcher alive to remove its private terminfo directory after exit.
status=0
"$binary" pty-probe --terminfo "$terminfo_dir" -- /bin/zsh || status=$?
exit "$status"
